@{
    ViewData["Title"] = "Home Page";
}

<img class="logo" src="~/assets/img/WWTBAM_logo.png" alt="" style="width: 20rem;">
<div class="menu">
    @* <a class="help button" href="">Your Room</a> *@
    <a class="play button" asp-action="StartGame" asp-controller="Game">Play</a>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <a class="play button" asp-area="admin" asp-action="Logout" style="padding:5%;" asp-controller="AccountAdmin">
            <span style="overflow: hidden;
    text-overflow: ellipsis;">Hi, @User.Identity.Name</span><span>!Logout</span>
        </a>
        <a class="play button" asp-area="admin" asp-action="Index" asp-controller="RoomAdmin">Your Room</a>
    }
    else
    {
        <a class="play button" asp-area="admin" asp-action="Login" asp-controller="AccountAdmin">Sign In</a>
        <a class="play button" asp-area="admin" asp-action="Register" asp-controller="AccountAdmin">Sign Up</a>
    }
    @if (User.IsInRole("Admin"))
    {
        <a class="play button" asp-action="Index" asp-controller="Admin">Trang quản trị</a>
    }
    
</div>
