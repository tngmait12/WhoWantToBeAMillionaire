@model IEnumerable<QuestionModel>


@* <a asp-action="Details" asp-controller="RoomAdmin" asp-route-Id="@ViewBag.RoomId" class="btn btn-secondary"><i class="fas fa-arrow-circle-left"></i></a> *@
<a asp-action="Details" asp-controller="RoomAdmin" asp-route-Id="@ViewBag.RoomId" class="btn btn-sm btn-outline-info float-left mr-1"><i class="fas fa-angle-left"></i> <span class="btn-header">Return</span></a>
<div class="container">
    <div class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-header d-flex align-items-center">
                    Questions
                    @* <a asp-action="Create" asp-controller="QuestionAdmin" asp-route-roomId="@ViewBag.RoomId" class="btn btn-success ml-auto">Create Question</a> *@
                    <a asp-action="Create" asp-controller="QuestionAdmin" asp-route-roomId="@ViewBag.RoomId" class="btn btn-sm btn-outline-primary ml-auto"><i class="fas fa-plus-circle"></i> Create Question</a>
                </div>
                <div class="card-body">
                    <p class="card-title"></p>
                    <table class="table table-hover" id="dataTables-example" width="100%">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Content</th>
                                <th>CorrectAnswer</th>
                                <th>Wrong_1</th>
                                <th>Wrong_2</th>
                                <th>Wrong_3</th>
                                <th>Difficulty</th>
                                <th>Topic</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Content</td>
                                    <td>@item.CorrectAnswer</td>
                                    <td>@item.Wrong_1</td>
                                    <td>@item.Wrong_2</td>
                                    <td>@item.Wrong_3</td>
                                    <td>
                                        @if (item.Difficulty == 1)
                                        {
                                            <span class="text text-success">Easy</span>
                                        }
                                        else if (item.Difficulty == 2)
                                        {
                                            <span class="text text-warning">Medium</span>
                                        }
                                        else
                                        {
                                            <span class="text text-danger">Difficulty</span>
                                        }
                                    </td>
                                    <td>
                                        @item.Topic.Name
                                    </td>
                                    <td>
                                        <a asp-action="Edit" class="btn btn-outline-info btn-rounded" asp-controller="QuestionAdmin" asp-route-roomId="@ViewBag.RoomId" asp-route-Id="@item.Id"><i class="fas fa-pen"></i></a>
                                        <a onclick="return confirm('Are u sure to delete?')" asp-action="Delete" class="btn btn-outline-danger btn-rounded confirmDeletion" asp-controller="QuestionAdmin" asp-route-roomId="@ViewBag.RoomId" asp-route-Id="@item.Id"><i class="fas fa-trash"></i></a>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
