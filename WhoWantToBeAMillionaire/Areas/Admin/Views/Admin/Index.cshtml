<div class="container">
    <div class="row">
        <div class="col-md-12 page-header">
            <div class="page-pretitle">Overview</div>
            <h2 class="page-title">Dashboard</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-sm-6 col-md-6 col-lg-3 mt-3">
            <div class="card">
                <div class="content">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="icon-big text-center">
                                <i class="teal fas fa-user-secret"></i>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="detail">
                                <p class="detail-subtitle">Users Online</p>
                                <span id="onlineUsers" class="number">0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-6 col-lg-3 mt-3">
            <div class="card">
                <div class="content">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="icon-big text-center">
                                <i class="olive fas fa-gamepad"></i>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="detail">
                                <p class="detail-subtitle">Rooms</p>
                                <span class="number">@ViewBag.CountRoom</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-6 col-lg-3 mt-3">
            <div class="card">
                <div class="content">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="icon-big text-center">
                                <i class="violet fas fa-users"></i>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="detail">
                                <p class="detail-subtitle">Users</p>
                                <span class="number">@ViewBag.CountUser</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-6 col-lg-3 mt-3">
            <div class="card">
                <div class="content">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="icon-big text-center">
                                <i class="orange fas fa-th-list"></i>
                            </div>
                        </div>
                        <div class="col-sm-8">
                            <div class="detail">
                                <p class="detail-subtitle">Topics</p>
                                <span class="number">@ViewBag.CountTopic</span>
                            </div>
                        </div>
                    </div>
@*                     <div class="footer">
                        <hr />
                        <div class="stats">
                            <i class="fas fa-envelope-open-text"></i> For this week
                        </div>
                    </div> *@
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-6">
                    <div class="card">
                        <div class="content">
                            <div class="head">
                                <h5 class="mb-0">Traffic Overview</h5>
                                <p class="text-muted">Current year website visitor data</p>
                            </div>
                            <div class="canvas-wrapper">
                                <canvas class="chart" id="trafficflow"></canvas>
                            </div>
                            <div class="ui hidden divider"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            var trafficchart = document.getElementById("trafficflow");
            var myChart1 = new Chart(trafficchart, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        backgroundColor: "rgba(48, 164, 255, 0.5)",
                        borderColor: "rgba(48, 164, 255, 0.8)",
                        data: [],
                        label: 'Player Rounds',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    title: { display: false, text: 'Chart' },
                    legend: { position: 'top', display: false, },
                    tooltips: { mode: 'index', intersect: false, },
                    hover: { mode: 'nearest', intersect: true },
                    scales: {
                        xAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Months'
                            }
                        }],
                        yAxes: [{
                            display: true,
                            scaleLabel: {
                                display: true,
                                labelString: 'Number of Player Rounds'
                            }
                        }]
                    }
                }
            });

            function updateChart(data) {
                var labels = [];
                var trafficData = [];

                // Duyệt qua dữ liệu và tạo nhãn (tháng) và dữ liệu (số lượt truy cập)
                data.forEach(function (item) {
                    var date = new Date(2025, item.month - 1);  // Sử dụng 'month' từ dữ liệu JSON
                    var monthName = date.toLocaleString('default', { month: 'short' });  // Lấy tên tháng
                    labels.push(monthName);  // Thêm vào mảng labels
                    trafficData.push(item.visitorCount);  // Thêm số lượt truy cập vào mảng trafficData
                });

                console.log(labels);  // Kiểm tra lại labels
                console.log(trafficData);  // Kiểm tra lại trafficData

                // Cập nhật dữ liệu vào biểu đồ
                myChart1.data.labels = labels;  // Cập nhật nhãn (tháng)
                myChart1.data.datasets[0].data = trafficData;  // Cập nhật số lượt truy cập vào dữ liệu
                myChart1.update();  // Cập nhật biểu đồ
            }


            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetChartData", "Admin")',
                datatype: "json",
                success: function (trafficData) {
                    console.log(trafficData);
                    updateChart(trafficData); // Hàm cập nhật biểu đồ
                }
            });

        });
    </script>

}
